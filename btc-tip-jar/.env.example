# Bitcoin Tip Jar Environment Variables
# Copy this file to .env and fill in your actual values

# ===========================================
# VOLTAGE API CREDENTIALS (Required)
# ===========================================
# Get these from your Voltage dashboard at https://voltage.cloud
# 1. Create account and select "Payments" product
# 2. Create an environment (e.g., "staging")
# 3. Create a mutinynet developer wallet
# 4. Get these values from the developer info section

VITE_VOLTAGE_API_KEY=vltg_4JkWafTmFRsBEmkFQMRAnXCBeNsmzGWC
VITE_VOLTAGE_ORG_ID=5ad1ad8d-5f47-4c9f-82f1-ee63ea1f2c29
VITE_VOLTAGE_ENV_ID=581dd84b-7b1c-46be-9230-516bd387bf6c
VITE_VOLTAGE_WALLET_ID=f9757f38-1c2e-449f-8c18-02ca30eb535f

# ===========================================
# CUSTOMIZATION (Optional)
# ===========================================
# Customize the branding for your improv group

VITE_TIP_JAR_NAME="The Comedy Collective"
VITE_TIP_JAR_SLOGAN="Support our improv shows and keep the laughs coming!"

# ===========================================
# SETUP INSTRUCTIONS
# ===========================================
# 
# 1. VOLTAGE SETUP:
#    - Go to https://voltage.cloud
#    - Create account and log in
#    - Select "Payments" product
#    - Create an environment (call it "staging" or similar)
#    - Create a mutinynet developer wallet
#    - Click the developer toggle to show developer info
#    - Copy Organization ID, Environment ID, and Wallet ID
#    - Go to account dropdown → API Keys
#    - Create API key for your staging environment
#    - Copy the API key
#
# 2. TESTING:
#    - Create a 2nd wallet in Voltage for testing payments
#    - Or use the Mutinynet faucet: https://faucet.mutinynet.com/
#    - Or use any mutinynet-compatible Lightning wallet
#
# 3. CUSTOMIZATION:
#    - Update VITE_TIP_JAR_NAME with your improv group's name
#    - Update VITE_TIP_JAR_SLOGAN with your custom message
#    - Modify tip amounts/messages in src/App.tsx if desired
#
# 4. PRODUCTION:
#    - For production, create a mainnet wallet instead of mutinynet
#    - Update all environment variables accordingly
#    - Deploy to Netlify with environment variables set in dashboard
