# Bitcoin Tip Jar Configuration
# Network: 'testnet' or 'mainnet'
NETWORK=testnet

# Extended Public Key (xpub) for watch-only wallet - REQUIRED
# Generate offline using: https://iancoleman.io/bip39/ or secure hardware wallet
XPUB=

# Esplora API endpoint for blockchain data
ESPLORA_URL=https://blockstream.info/testnet/api

# Optional: Custom derivation path (default: m/84'/1'/0'/0 for testnet)
DERIVATION_PATH=m/84'/1'/0'/0

# Database file for storing address index and payment history
DB_FILE=./data/tipjar.json